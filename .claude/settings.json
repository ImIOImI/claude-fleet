{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Read(docs/**)",
      "Read(CLAUDE.md)",
      "Read(.claude/rules/**)",
      "Edit(docs/**)",
      "Edit(CLAUDE.md)",
      "Edit(.claude/rules/**)",
      "Write(docs/**)",
      "Write(CLAUDE.md)",
      "Write(.claude/rules/**)",
      "Bash(git *)",
      "Bash(npm *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(pwd)",
      "Bash(docker *)"
    ],
    "ask": [
      "Bash(git rebase *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git commit --amend *)",
      "Bash(git filter-branch *)",
      "Bash(git filter-repo *)"
    ]
  }
}
