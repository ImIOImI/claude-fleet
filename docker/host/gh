#!/bin/sh
# gh with a short-lived App token scoped to the repo it acts on (fleet-host-cred
# gh-token). An explicit GH_TOKEN wins; no resolvable repo runs gh without one.
real=${FLEET_GH_REAL:-/usr/local/bin/gh}
if [ ! -x "$real" ]; then
  echo "gh is not installed in this image" >&2
  exit 127
fi
if [ -z "${GH_TOKEN:-}" ]; then
  # stdout is the token; the first stderr line, cut to 200 bytes, reaches the user.
  tok=$( { fleet-host-cred gh-token -- "$@" 2>&1 1>&3 3>&- | head -n 1 | cut -c1-200 >&2; } 3>&1 ) || tok=
  if [ -n "$tok" ]; then
    GH_TOKEN=$tok
    export GH_TOKEN
  fi
fi
exec "$real" "$@"
