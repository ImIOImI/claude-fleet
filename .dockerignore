# Dockerfile context = repo root. Default everything OUT, then opt in
# only the paths the multi-stage build actually needs (broker module +
# the Dockerfile itself). Keeps node_modules, dist outputs, design docs,
# tests, and IDE state out of every build layer's hash.
**

!broker/**
!docker/Dockerfile
# Shared install scripts the devops (and future) images COPY — they build from
# this same repo-root context (see docker/devops/Dockerfile).
!docker/scripts/**
# Runner hook assets the base image COPYs in (input-wait-report.sh +
# hooks.settings.json) — loaded via `claude --settings` for the waiting-chip.
# Without this opt-in those COPYs fail with "not found" and the publish breaks.
!docker/runner/**
# runner-host: the fleet-host bundle's inputs (docker/host/Dockerfile).
!docker/host/**
!package.json
!package-lock.json
!tsconfig.host.json
!vite.host.config.ts
!src/host/**
!src/main/identity/**
!src/main/broker.ts
!src/main/claudeArgs.ts
!src/main/vaultScopes.ts
!src/preload/identityTypes.ts

# Even within broker/, drop things the binary doesn't need:
broker/**/*_test.go
broker/cmd/**/testdata/**
# …and the runner hook test harness — not COPYd into any image.
docker/runner/*.test.sh
src/**/*.test.ts
src/host/testFakes.ts
src/host/testHost.ts
docker/host/*.test.sh
